# FUTBIN Settings
FUTBIN_URL=https://www.futbin.com

# FUT.GG Settings
FUTGG_URL=https://www.fut.gg

# FUTWIZ Settings
FUTWIZ_URL=https://www.futwiz.com

# FutNext Settings
